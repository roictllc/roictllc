{
  "name": "roi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @roi/web",
    "build": "npm run db:generate && npm run build -w @roi/web",
    "lint": "npm run lint -w @roi/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --config packages/database/prisma.config.ts",
    "db:check": "tsx packages/database/scripts/db-check.ts",
    "db:migrate:deploy": "prisma migrate deploy --config packages/database/prisma.config.ts",
    "db:seed": "tsx packages/database/seed/seed.ts",
    "link-check": "tsx infrastructure/scripts/link-check.ts",
    "worker": "tsx apps/worker/src/main.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@prisma/internals": "^7.10.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  }
}
