# ROI — environment manifest (spec §3). Placeholders only. Never commit real values.
APP_ENV=development            # development | staging | production
APP_URL=https://roictllc.com
SESSION_SECRET=                # openssl rand -base64 48
CSRF_SECRET=                   # openssl rand -base64 24
INTEGRATION_ENCRYPTION_KEY=    # openssl rand -base64 32  (AES-256-GCM)
DATABASE_URL=                  # Neon pooled (…-pooler…) or any Postgres
DATABASE_URL_UNPOOLED=         # Neon direct, used for migrations
DIRECT_URL=                    # = DATABASE_URL_UNPOOLED
NEON_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=             # sk_test_… in development/staging, restricted live key in production
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=ROI <hello@mail.roictllc.com>
EMAIL_REPLY_TO=roictllc@gmail.com
COMPANY_POSTAL_ADDRESS=        # required in marketing email (also editable in /admin/settings → company)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=          # Pages edit, DNS edit, Zone read
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=
R2_BUCKET_PUBLIC=
R2_PUBLIC_BASE_URL=https://assets.roictllc.com
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REGISTRAR_PROVIDER=            # porkbun | namecheap | dynadot | cloudflare
REGISTRAR_API_KEY=
REGISTRAR_API_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0       # verify current version at deploy time
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USPTO_API_KEY=
LOCAL_LLM_BASE_URL=            # optional Ollama/llama.cpp on ROI's own server
SERVER_SSH_HOST=
SERVER_SSH_USER=
SERVER_SSH_KEY=
SENTRY_DSN=
# First admin (seed): created only if no ADMIN exists; must change password + enroll 2FA at first sign-in
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD_HASH_B64= # base64 of an argon2id hash (preferred) — or SEED_ADMIN_PASSWORD for local dev only
# Development/test only
LOCAL_STORAGE_DIR=             # local file storage when R2 is not configured (never in production)
PREVIEW_NOINDEX=               # 1 on non-canonical preview hosts
