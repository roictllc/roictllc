// ROI LLC — PostgreSQL schema (spec v4 §5). Money = integer cents (+ currency); small API costs in millicents (1/1000 cent).
// All DateTime columns are timestamptz(3) (enforced by packages/database/scripts/check-schema.ts).
// Tables are snake_case via @@map. Customer-owned rows carry workspaceId.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────
enum RoleName {
  ADMIN
  PM
  MANAGER
  CUSTOMER
  AFFILIATE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Visibility {
  HIDDEN
  COMING_SOON
  LIVE
}

enum ProductKind {
  ONE_TIME
  SUBSCRIPTION
  QUOTE
  PER_ITEM
}

enum DeliveryMode {
  AUTOMATED
  MANAGED
  HYBRID
}

enum PriceInterval {
  ONE_TIME
  MONTH
  YEAR
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  INCOMPLETE
  SUSPENDED
}

enum JobStatus {
  PENDING
  PROCESSING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELED
  DEAD
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  REJECTED
}

enum LedgerType {
  REVENUE
  REFUND
  FEE
  EXPENSE
  COMMISSION
  PAYOUT
  TAX
}

enum ExpenseCategory {
  HOSTING
  DOMAINS
  SOFTWARE
  ADVERTISING
  SUPPORT
  STORAGE
  EMAIL
  AI_COMPUTE
  SOCIAL_API
  AFFILIATE
  OTHER
}

enum IntegrationStatus {
  AWAITING_CONFIGURATION
  CONNECTED
  ERROR
  DISABLED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  X
}

enum PostingMode {
  APPROVE_FIRST
  AUTO_PUBLISH
  MANAGER_REVIEW
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum WebsiteStatus {
  DRAFT
  PREVIEW
  PUBLISHING
  LIVE
  SUSPENDED
  ARCHIVED
}

enum DomainStatus {
  QUOTED
  PENDING_PAYMENT
  REGISTERING
  ACTIVE
  EXPIRED
  TRANSFERRED_OUT
  EXTERNAL
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum CommissionStatus {
  PENDING
  PAYABLE
  PAID
  CLAWED_BACK
}

enum DataSource {
  MEASURED
  ESTIMATED
}

// ───────────────────────────── Identity ─────────────────────────────
model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String?
  passwordHash       String
  role               RoleName   @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?  @db.Timestamptz(3)
  mustChangePassword Boolean    @default(false)
  twoFactorEnabled   Boolean    @default(false)
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  archivedAt         DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  sessions            UserSession[]
  passwordResets      PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  twoFactorSecret     TwoFactorSecret?
  recoveryCodes       RecoveryCode[]
  customer            Customer?
  managerProfile      ManagerProfile?
  managerAssignments  ManagerAssignment[]
  affiliateProfile    AffiliateProfile?
  impersonationGrants ImpersonationGrant[]
  notifications       Notification[]
  orders              Order[]
  ownedWorkspaces     BusinessWorkspace[]      @relation("WorkspaceOwner")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  name        RoleName         @id
  description String
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  key         String           @id
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@map("permissions")
}

model RolePermission {
  roleName      RoleName
  permissionKey String
  role          Role       @relation(fields: [roleName], references: [name], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  @@id([roleName, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model UserSession {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  familyId            String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip                  String?
  userAgent           String?
  twoFactorVerifiedAt DateTime? @db.Timestamptz(3)
  lastSeenAt          DateTime  @default(now()) @db.Timestamptz(3)
  idleExpiresAt       DateTime  @db.Timestamptz(3)
  expiresAt           DateTime  @db.Timestamptz(3)
  revokedAt           DateTime? @db.Timestamptz(3)
  revokedReason       String?
  rotatedToId         String?
  impersonatorId      String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([createdAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([createdAt])
  @@map("email_verification_tokens")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model TwoFactorSecret {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String
  enabledAt       DateTime? @db.Timestamptz(3)
  lastUsedStep    Int?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@map("two_factor_secrets")
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("recovery_codes")
}

model ImpersonationGrant {
  id          String            @id @default(cuid())
  adminId     String
  admin       User              @relation(fields: [adminId], references: [id], onDelete: Restrict)
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reason      String
  expiresAt   DateTime          @db.Timestamptz(3)
  endedAt     DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([adminId])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("impersonation_grants")
}

// ───────────────────────────── Workspace ─────────────────────────────
model BusinessWorkspace {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  ownerId          String
  owner            User      @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stripeCustomerId String?   @unique
  status           String    @default("ACTIVE")
  archivedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  customers           Customer[]
  profile             BusinessProfile?
  managerAssignments  ManagerAssignment[]
  projects            CustomerProject[]
  assets              CustomerAsset[]
  orders              Order[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  deliverables        GeneratedDeliverable[]
  websites            Website[]
  domains             Domain[]
  socialAccounts      SocialAccount[]
  socialPosts         SocialPost[]
  brandKit            BrandKit?
  tickets             SupportTicket[]
  aiConnections       ClientAiConnection[]
  impersonationGrants ImpersonationGrant[]
  jobs                AutomationJob[]
  logoConcepts        LogoConcept[]
  ebookPurchases      EBookPurchase[]
  signatureSets       SignatureSet[]
  seoAudits           SeoAudit[]
  aiVisibilityAudits  AiVisibilityAudit[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("business_workspaces")
}

model Customer {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phone       String?
  marketingOk Boolean           @default(false)
  archivedAt  DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([workspaceId])
  @@index([createdAt])
  @@map("customers")
}

model BusinessProfile {
  id           String            @id @default(cuid())
  workspaceId  String            @unique
  workspace    BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  displayName  String
  legalName    String?
  logoAssetId  String?
  industry     String?
  description  String?
  colors       Json?
  phone        String?
  email        String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String            @default("US")
  serviceAreas Json?
  hours        Json?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@map("business_profiles")
}

model ManagerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  capacity  Int      @default(25)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("manager_profiles")
}

model ManagerAssignment {
  id          String            @id @default(cuid())
  managerId   String
  manager     User              @relation(fields: [managerId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([managerId, workspaceId])
  @@index([workspaceId])
  @@map("manager_assignments")
}

model CustomerProject {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  status      String            @default("OPEN")
  productSlug String?
  notes       String?
  archivedAt  DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
  @@map("customer_projects")
}

model CustomerAsset {
  id           String            @id @default(cuid())
  workspaceId  String
  workspace    BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind         String
  storageKey   String            @unique
  mime         String
  sizeBytes    Int
  sha256       String
  width        Int?
  height       Int?
  originalName String?
  scanStatus   ScanStatus        @default(PENDING)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  logoUploads LogoUpload[]

  @@index([workspaceId])
  @@index([scanStatus])
  @@index([sha256])
  @@index([createdAt])
  @@map("customer_assets")
}

// ───────────────────────────── Catalog ─────────────────────────────
model ProductCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@map("product_categories")
}

model Product {
  id                   String          @id @default(cuid())
  number               Int             @unique
  slug                 String          @unique
  name                 String
  tagline              String
  shortDescription     String
  longDescription      String
  answerFirst          String
  categoryId           String
  category             ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  kind                 ProductKind
  deliveryMode         DeliveryMode
  visibility           Visibility      @default(HIDDEN)
  requiredIntegrations String[]
  faq                  Json
  honesty              String?
  taxCode              String?
  seoTitle             String
  seoDescription       String
  sortOrder            Int             @default(0)
  archivedAt           DateTime?       @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  plans        ProductPlan[]
  features     ProductFeature[]
  form         ProductForm?
  workflow     ProductWorkflow?
  costModel    ProductCostModel?
  orderItems   OrderItem[]
  revenue      RevenueEntry[]
  productCosts ProductionCost[]
  coupons      Coupon[]

  @@index([categoryId])
  @@index([visibility])
  @@index([createdAt])
  @@map("products")
}

model ProductPlan {
  id          String           @id @default(cuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  isDefault   Boolean          @default(false)
  published   Boolean          @default(true)
  sortOrder   Int              @default(0)
  archivedAt  DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  prices      ProductPrice[]
  features    ProductFeature[]
  orderItems  OrderItem[]

  @@unique([productId, slug])
  @@index([productId])
  @@map("product_plans")
}

model ProductPrice {
  id            String        @id @default(cuid())
  planId        String
  plan          ProductPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  version       Int
  amountCents   Int
  currency      String        @default("usd")
  interval      PriceInterval
  stripePriceId String?       @unique
  activeFrom    DateTime      @default(now()) @db.Timestamptz(3)
  activeTo      DateTime?     @db.Timestamptz(3)
  createdById   String?
  reason        String?
  marginBps     Int?
  overrideNote  String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  orderItems    OrderItem[]
  subscriptions Subscription[]

  @@unique([planId, version])
  @@index([planId])
  @@index([activeFrom])
  @@map("product_prices")
}

model ProductFeature {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  planId    String?
  plan      ProductPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@index([productId])
  @@index([planId])
  @@map("product_features")
}

model ProductForm {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version   Int      @default(1)
  schema    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("product_forms")
}

model ProductInput {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  formVersion Int
  data        Json
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@map("product_inputs")
}

model ProductWorkflow {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  steps     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("product_workflows")
}

model ProductCostModel {
  id                         String   @id @default(cuid())
  productId                  String   @unique
  product                    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  feePercentBps              Int      @default(290)
  feeFixedCents              Int      @default(30)
  computeSecondsExpected     Int      @default(0)
  computeRateMillicentsPerS  Int      @default(1)
  storageMillicents          Int      @default(0)
  emailMillicents            Int      @default(0)
  domainCostCents            Int      @default(0)
  socialApiMillicentsPerPost Int      @default(0)
  postsPerPeriod             Int      @default(0)
  supportAllowanceCents      Int      @default(0)
  refundAllowanceBps         Int      @default(0)
  minMarginBps               Int      @default(4000)
  notes                      String?
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  @@map("product_cost_models")
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOffBps  Int?
  amountOffCents Int?
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime? @db.Timestamptz(3)
  active         Boolean   @default(true)
  stripeCouponId String?   @unique
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  orders         Order[]

  @@index([productId])
  @@map("coupons")
}

model Bundle {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  planIds     String[]
  amountCents Int
  interval    PriceInterval
  published   Boolean       @default(false)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  @@map("bundles")
}

// ───────────────────────────── Commerce ─────────────────────────────
model Cart {
  id          String     @id @default(cuid())
  userId      String?
  workspaceId String?
  status      String     @default("OPEN")
  items       CartItem[]
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([workspaceId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  planId    String
  quantity  Int      @default(1)
  inputs    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([cartId])
  @@index([planId])
  @@map("cart_items")
}

model Order {
  id                       String            @id @default(cuid())
  orderNumber              String            @unique
  workspaceId              String
  workspace                BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId                   String
  user                     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                   OrderStatus       @default(PENDING_PAYMENT)
  subtotalCents            Int
  discountCents            Int               @default(0)
  taxCents                 Int               @default(0)
  totalCents               Int
  currency                 String            @default("usd")
  couponId                 String?
  coupon                   Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  referralId               String?
  stripeCheckoutSessionId  String?           @unique
  stripePaymentIntentId    String?           @unique
  consentImmediateDelivery Boolean           @default(false)
  consentText              String?
  consentAt                DateTime?         @db.Timestamptz(3)
  paidAt                   DateTime?         @db.Timestamptz(3)
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)

  items      OrderItem[]
  payments   Payment[]
  taxRecords TaxRecord[]
  ledger     FinancialTransaction[]

  @@index([workspaceId])
  @@index([userId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  planId          String
  plan            ProductPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  priceId         String
  price           ProductPrice @relation(fields: [priceId], references: [id], onDelete: Restrict)
  quantity        Int          @default(1)
  unitAmountCents Int
  status          JobStatus    @default(PENDING)
