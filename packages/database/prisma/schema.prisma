  @@map("support_attachments")
}

model ContentReport {
  id            String   @id @default(cuid())
  targetType    String
  targetId      String
  reason        String
  details       String?
  reporterEmail String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([targetType, targetId])
  @@index([status])
  @@map("content_reports")
}

model Takedown {
  id              String    @id @default(cuid())
  kind            String
  claimantName    String
  claimantEmail   String
  claimantAddress String?
  url             String
  workDescription String
  statements      Json
  signature       String
  status          String    @default("RECEIVED")
  targetType      String?
  targetId        String?
  decidedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([createdAt])
  @@map("takedowns")
}

model ModerationDecision {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  decision    String
  reason      String
  decidedById String?
  automatic   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([targetType, targetId])
  @@map("moderation_decisions")
}

model BlockedTerm {
  id        String   @id @default(cuid())
  term      String   @unique
  kind      String
  severity  String   @default("BLOCK")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("blocked_terms")
}

// ───────────────────────────── Marketing email ─────────────────────────────
model EmailTemplate {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  kind      String
  subject   String
  html      String
  text      String
  campaigns EmailCampaign[]
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  @@map("email_templates")
}

model EmailCampaign {
  id          String        @id @default(cuid())
  name        String
  templateId  String
  template    EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  segment     Json
  status      String        @default("DRAFT")
  scheduledAt DateTime?     @db.Timestamptz(3)
  sentAt      DateTime?     @db.Timestamptz(3)
  stats       Json?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  events      EmailEvent[]

  @@index([templateId])
  @@index([status])
  @@map("email_campaigns")
}

model EmailSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  status           SubscriberStatus @default(SUBSCRIBED)
  workspaceId      String?
  tags             String[]
  unsubscribeToken String           @unique
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  consents         EmailConsent[]
  events           EmailEvent[]

  @@index([status])
  @@map("email_subscribers")
}

model EmailConsent {
  id           String          @id @default(cuid())
  subscriberId String
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  source       String
  ip           String?
  text         String
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@index([subscriberId])
  @@map("email_consents")
}

model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("email_suppressions")
}

model EmailEvent {
  id                String           @id @default(cuid())
  eventId           String           @unique
  subscriberId      String?
  subscriber        EmailSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  campaignId        String?
  campaign          EmailCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  providerMessageId String?
  type              String
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  @@index([subscriberId])
  @@index([campaignId])
  @@index([type])
  @@map("email_events")
}

model MarketingCampaign {
  id        String    @id @default(cuid())
  name      String
  channel   String
  utm       Json?
  startedAt DateTime? @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@map("marketing_campaigns")
}

// ───────────────────────────── Affiliates ─────────────────────────────
model AffiliateProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String       @unique
  status        String       @default("PENDING")
  commissionBps Int          @default(1000)
  approvedAt    DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  referrals     Referral[]
  commissions   Commission[]
  payouts       Payout[]

  @@map("affiliate_profiles")
}

model Referral {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  cookieId    String           @unique
  workspaceId String?
  landingUrl  String?
  ipHash      String?
  clickedAt   DateTime         @db.Timestamptz(3)
  convertedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  commissions Commission[]

  @@index([affiliateId])
  @@index([workspaceId])
  @@map("referrals")
}

model Commission {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referralId  String?
  referral    Referral?        @relation(fields: [referralId], references: [id], onDelete: SetNull)
  orderId     String           @unique
  amountCents Int
  status      CommissionStatus @default(PENDING)
  holdUntil   DateTime         @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([affiliateId])
  @@index([referralId])
  @@index([status])
  @@map("commissions")
}

model Payout {
  id           String           @id @default(cuid())
  affiliateId  String
  affiliate    AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountCents  Int
  status       String           @default("PENDING")
  reference    String?
  approvedById String?
  paidAt       DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  @@index([affiliateId])
  @@map("payouts")
}

// ───────────────────────────── Platform ─────────────────────────────
model Integration {
  id             String            @id @default(cuid())
  key            String            @unique
  name           String
  status         IntegrationStatus @default(AWAITING_CONFIGURATION)
  requiredEnv    String[]
  missingEnv     String[]
  unlocks        String[]
  ownerStep      String
  lastCheckAt    DateTime?         @db.Timestamptz(3)
  lastError      String?
  credentialsEnc String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@map("integrations")
}

model FeatureFlag {
  id          String     @id @default(cuid())
  key         String     @unique
  visibility  Visibility @default(HIDDEN)
  description String
  updatedById String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@map("feature_flags")
}

model Setting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  data       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime? @db.Timestamptz(3)
  error       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([createdAt])
  @@map("webhook_events")
}

model BackupRun {
  id         String    @id @default(cuid())
  kind       String
  status     String
  objectKey  String?
  sizeBytes  BigInt?
  details    Json?
  startedAt  DateTime  @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([kind, startedAt])
  @@map("backup_runs")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  topic     String
  message   String
  ip        String?
  status    String   @default("NEW")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model LegalDocument {
  slug       String   @id
  title      String
  body       String
  version    Int      @default(1)
  reviewNote String   @default("Attorney review recommended before launch.")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@map("legal_documents")
}
