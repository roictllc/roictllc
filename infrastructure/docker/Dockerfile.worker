# Media worker: FFmpeg, poppler, qpdf, ClamAV client libs, fonts; runs as non-root
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg poppler-utils qpdf fonts-dejavu-core ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm ci && npx prisma generate --config packages/database/prisma.config.ts
RUN useradd -r -u 10002 worker && mkdir -p /tmp/roi && chown worker /tmp/roi
USER worker
ENV TMPDIR=/tmp/roi NODE_ENV=production
CMD ["npx", "tsx", "apps/worker/src/main.ts"]
