# Next.js standalone web image (non-root, read-only friendly)
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages ./packages
RUN npm ci
FROM deps AS build
COPY . .
RUN npx prisma generate --config packages/database/prisma.config.ts && npm run build -w @roi/web
FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
RUN useradd -r -u 10001 roi
COPY --from=build --chown=roi /app/apps/web/.next/standalone ./
COPY --from=build --chown=roi /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=roi /app/apps/web/public ./apps/web/public
COPY --from=build --chown=roi /app/packages/database ./packages/database
USER roi
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://localhost:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
